{
  "name": "best",
  "productName": "Best",
  "version": "1.0.4",
  "description": "Best — desktop proxy client (Xray + sing-box)",
  "main": "electron/main.js",
  "private": true,
  "author": "Best",
  "homepage": "https://github.com/Mo7amadd/Best",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mo7amadd/Best.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "validate": "node scripts/validate-configs.js",
    "fonts": "node scripts/copy-fonts.js",
    "icons": "node scripts/make-icons.js",
    "dist": "npm run fonts && npm run icons && electron-builder --win nsis && node scripts/make-portable.js",
    "dist:mac": "npm run fonts && npm run icons && node scripts/fetch-mac-cores.js && electron-builder --mac",
    "art": "electron scripts/make-installer-art.js",
    "test:ui": "node test/ui/run.mjs",
    "test:perf": "node test/ui/perf.mjs",
    "test:soak": "node test/ui/soak.mjs",
    "test:live": "node test/live/connect.js"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "country-flag-emoji-polyfill": "^0.1.10",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "vazirmatn": "^33.0.3"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "com.best.client",
    "productName": "Best",
    "copyright": "Best",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": [
          "**/*",
          "!mac-*"
        ]
      },
      {
        "from": "build/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Best-Setup-v${version}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "resources/cores",
          "to": "cores"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.utilities",
      "artifactName": "Best-v${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Best looks for a QR code on the screen when you ask it to scan one."
      },
      "extraResources": [
        {
          "from": "resources/cores-mac-${arch}",
          "to": "cores"
        },
        {
          "from": "resources/icons",
          "to": "icons",
          "filter": [
            "mac-*"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Best ${version}",
      "artifactName": "Best-v${version}-mac-${arch}.${ext}",
      "background": "build/mac/dmg-background.png",
      "window": {
        "width": 600,
        "height": 400
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 170,
          "y": 175,
          "type": "file"
        },
        {
          "x": 430,
          "y": 175,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 465,
          "y": 50,
          "type": "file",
          "path": "build/mac/If Best does not open.html"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Best",
      "uninstallDisplayName": "Best",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "unicode": true
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "45.3.2"
  },
  "best": {
    "updateRepo": "Mo7amadd/Best"
  }
}
