<?xml version="1.0" encoding="utf-8"?>
<!-- Best's own requests (subscriptions, updates) use HTTPS with the system's CA store only;
     certificates the user installed are not trusted. Plain HTTP subscription links are allowed,
     as on Windows, but the app warns about them before use. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
